# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_xxx
# Same value as RAZORPAY_KEY_ID — the key ID is safe to expose (it identifies the
# account, not a secret), but the client-side Checkout widget needs its own
# NEXT_PUBLIC_ var since server-only env vars aren't available in the browser bundle.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-secret
RAZORPAY_WEBHOOK_SECRET=whsec_xxx

# Resend (Transactional Emails)
RESEND_API_KEY=re_xxx
EMAIL_FROM=DEWDROPZ <orders@dewdropz.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3010
NEXT_PUBLIC_APP_NAME=DEWDROPZ

# Admin
ADMIN_EMAILS=admin@dewdropz.com

# Scheduled jobs. Both cron routes refuse every request unless this is set, so
# they cannot run open to the internet by accident. Point an external scheduler
# (Vercel Cron, GitHub Actions, cron-job.org) at:
#   GET /api/cron/release-stale-orders        — releases stock held by unpaid orders
#   GET /api/cron/recover-abandoned-carts     — emails abandoned carts (add ?dryRun=1 to preview)
#   GET /api/cron/run-jobs                    — drains the outbound job queue; run this one every minute
# sending `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=a-long-random-string