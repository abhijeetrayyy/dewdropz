# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and this is that opt-in. .env.example carries no values, only the
# variable names and placeholders a new clone needs in order to boot, so
# it is the one env file that is useless unless it is committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — local agent skills. .claude/launch.json stays tracked, since the
# dev/prod server definitions are shared; skills are per-machine.
.claude/skills/

# Supabase CLI scratch (written by `npx supabase`, never part of the schema)
supabase/.temp/

# The Expo/React Native companion app. 20GB of node_modules and native build
# artefacts (11G node_modules, 6.7G ios, 2.1G android) — it needs its own
# repository with its own ignore rules, not a corner of this one.
/trekbuddy-game/

# Scratch notes from the 26-Aug platform audit. The deliverable is
# PLATFORM-AUDIT.md at the root; these are the workings behind it.
/.audit/
.doc-shots/
